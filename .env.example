# Copy to .env and adjust for your machine.
STOCKLAB_ENV=local
STOCKLAB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STOCKLAB_CORS_ORIGIN_REGEX=
STOCKLAB_DATABASE_URL=postgresql+psycopg://stocklab:stocklab@127.0.0.1:5432/stocklab
STOCKLAB_DATA_START_DATE=2016-01-01

# Auth: dev mode logs emails and returns action tokens in API responses.
# Never enable in production; configure SMTP instead.
STOCKLAB_AUTH_DEV_MODE=true
STOCKLAB_JWT_SECRET=replace-with-a-random-32-byte-secret
STOCKLAB_OTP_SECRET=replace-with-another-random-32-byte-secret
STOCKLAB_GUEST_DAILY_LIMIT=20
STOCKLAB_FREE_DAILY_LIMIT=50
STOCKLAB_REGISTRATION_INVITE_CODE=
STOCKLAB_REGISTRATION_INVITE_REQUIRED=false

# Email verification and password reset.
# Provider: smtp | resend | brevo. Dev mode skips delivery and returns tokens.
STOCKLAB_EMAIL_PROVIDER=smtp
STOCKLAB_EMAIL_FROM=
STOCKLAB_RESEND_API_KEY=
STOCKLAB_BREVO_API_KEY=
STOCKLAB_SMTP_HOST=
STOCKLAB_SMTP_PORT=587
STOCKLAB_SMTP_USERNAME=
STOCKLAB_SMTP_PASSWORD=
STOCKLAB_SMTP_FROM=
STOCKLAB_SMTP_STARTTLS=true
STOCKLAB_SMTP_SSL=false
STOCKLAB_FRONTEND_URL=http://127.0.0.1:3000

# EasyPay page-redirect checkout (ezfpy).
# Keep EZFPY_KEY server-side only; never expose it to the browser.
STOCKLAB_EZFPY_BASE_URL=https://www.ezfpy.cn
STOCKLAB_EZFPY_PID=
STOCKLAB_EZFPY_KEY=
STOCKLAB_EZFPY_NOTIFY_URL=
STOCKLAB_EZFPY_RETURN_URL=

# Browser-side API base (build-time for Next.js)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
